{
	"name": "eclat-server",
	"version": "1.0.0",
	"main": "server.js",
	"private": true,
	"type": "module",
	"imports": {
		"#controllers/*": "./src/controllers/*",
		"#database/*": "./src/database/*",
		"#repositories/*": "./src/database/repositories/*",
		"#routes/*": "./src/routes/*",
		"#middleware/*": "./src/middleware/*",
		"#utils/*": "./src/utils/*"
	},
	"scripts": {
		"start": "NODE_ENV=production node server",
		"dev": "nodemon server",
		"docker:up": "docker compose -f ../compose.yaml up -d",
		"docker:down": "docker compose -f ../compose.yaml down",
		"docker:restart": "docker compose -f ../compose.yaml restart",
		"docker:logs": "docker compose -f ../compose.yaml logs -f",
		"db:migrate": "node src/scripts/migrate.js",
		"db:seed": "node src/scripts/seed.js",
		"db:setup": "docker compose -f ../compose.yaml up -d && node src/scripts/migrate.js && node src/scripts/seed.js",
		"db:reset": "docker compose -f ../compose.yaml down -v && docker compose -f ../compose.yaml up -d && node src/scripts/migrate.js && node src/scripts/seed.js",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"bcrypt": "^6.0.0",
		"colors": "^1.4.0",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.22.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"nodemon": "^3.1.14"
	}
}
