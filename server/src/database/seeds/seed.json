	"blog_posts": [
		{
			"id": "e2731ec7-3e01-4057-b1fc-4d55ab7b9de0",
			"slug": "jewelry-care-guide",
			"title": "The essential jewelry care guide",
			"excerpt": "A few thoughtful rituals keep your favorite pieces luminous for years to come.",
			"read_time": "4 min read",
			"category": "Care",
			"content": [
				"Jewelry is made for living in, but a little care preserves its quiet brilliance. Build a simple routine around the pieces you wear most.",
				"Remove your jewelry before swimming, showering, exercising, or applying fragrance and lotions. Moisture and everyday products can leave a residue on precious metals and stones.",
				"Store each piece separately in a soft pouch or lined box. This prevents chains from tangling and helps protect polished surfaces from scratches.",
				"To refresh its shine, wipe your jewelry with a soft, dry cloth after wearing. For delicate pieces and gemstones, avoid abrasive cleaners and seek professional advice when needed."
			],
			"url": "https://images.unsplash.com/photo-1617038220319-276d3cfab638?auto=format&fit=crop&w=1200&q=85",
			"created_at": "2026-07-20T09:00:00Z"
		},
		{
			"id": "f097f014-6eb5-449d-a020-90f39b8934e1",
			"slug": "how-to-choose-a-meaningful-gift",
			"title": "How to choose a meaningful gift",
			"excerpt": "From everyday signatures to milestone pieces, find a gift that feels considered and personal.",
			"read_time": "3 min read",
			"category": "Gifting",
			"content": [
				"The most memorable gifts begin with a small observation: what someone wears every day, the colors they reach for, or a moment worth marking.",
				"Choose a versatile silhouette for an everyday piece, or select a more distinctive design for a milestone. A thoughtful note makes the final detail feel entirely personal."
			],
			"url": "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=1200&q=85",
			"created_at": "2026-07-12T09:00:00Z"
		},
		{
			"id": "21b6fe9a-a779-40e8-928b-fc542a749469",
			"slug": "the-art-of-layering",
			"title": "The art of layering",
			"excerpt": "Create a jewelry wardrobe with considered proportions, texture, and a little contrast.",
			"read_time": "5 min read",
			"category": "Styling",
			"content": [
				"Layering is an exercise in balance. Begin with one piece that feels like your signature, then add a contrasting length, texture, or scale.",
				"Leave space between necklaces, stack rings across both hands, or pair a refined chain with a more sculptural pendant. The result should feel collected, not crowded."
			],
			"url": "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=1200&q=85",
			"created_at": "2026-07-05T09:00:00Z"
		}
	],
